# Passcode family members enter to see the calendar and book.
# Leave empty to let anyone with the link book.
FAMILY_PASSCODE=pards2026
# Passcode for the admin page (cancel any stay, block dates). Required.
ADMIN_PASSCODE=change-me
# Long random string used to sign login cookies: `openssl rand -hex 32`
# Optional: without it, cookies are signed with a key derived from the passcodes.
SESSION_SECRET=
# Where the SQLite file lives. Put it on a persistent disk in production.
DATABASE_PATH=data/casapards.db
# Time zone of the house, used for "today".
HOUSE_TIMEZONE=America/Los_Angeles
